# ==============================================================================
# Studio CRM & POLI Studio OS - Environment Configuration (.env.example)
# Stack: Node.js (ESM, >=20) + Express + Drizzle ORM (SQLite / better-sqlite3) + PWA
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Studio Operations & Notifications
STUDIO_MANAGER_EMAIL=manager@your-studio.example

# SQLite Local Database (Default: single local file)
SQLITE_DB_PATH=./data/studio_crm.sqlite

# Optional: PostgreSQL Database (For optional multi-user server hosting)
# SQL_HOST=localhost
# SQL_USER=postgres
# SQL_PASSWORD=
# SQL_DB_NAME=studio_crm
# SQL_ADMIN_USER=postgres
# SQL_ADMIN_PASSWORD=

# Automated Remote CSV Synchronization Config
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=30
SYNC_CLIENTS_CSV_URL=
SYNC_INVENTORY_CSV_URL=
CLIENT_CSV_URL=
INVENTORY_CSV_URL=
