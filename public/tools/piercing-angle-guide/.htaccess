# =====================================================
# PIERCING ANGLE & DEPTH GUIDE
# Apache Server Configuration for SEO Optimization
# =====================================================

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /standalone-tools/piercing-angle-guide/

    # Force HTTPS (if SSL is available)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Remove trailing slash
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]

    # Remove .html extension for cleaner URLs
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([^\.]+)$ $1.html [NC,L]

    # Redirect index.html to root
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /standalone-tools/piercing-angle-guide/index\.html\ HTTP/
    RewriteRule ^index\.html$ https://poliinternational.com/standalone-tools/piercing-angle-guide/ [R=301,L]
</IfModule>

# =====================================================
# COMPRESSION (Improve Page Speed)
# =====================================================

<IfModule mod_deflate.c>
    # Compress HTML, CSS, JavaScript, Text, XML
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# =====================================================
# BROWSER CACHING (Improve Page Speed)
# =====================================================

<IfModule mod_expires.c>
    ExpiresActive On

    # Images (1 year)
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"

    # CSS and JavaScript (1 month)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"

    # HTML (1 hour)
    ExpiresByType text/html "access plus 1 hour"

    # Fonts (1 year)
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Alternative using Cache-Control headers
<IfModule mod_headers.c>
    # Cache images for 1 year
    <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>

    # Cache CSS/JS for 1 month
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>

    # Cache HTML for 1 hour
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=3600, public, must-revalidate"
    </FilesMatch>
</IfModule>

# =====================================================
# SECURITY HEADERS
# =====================================================

<IfModule mod_headers.c>
    # Prevent clickjacking (except for embeds from our domain)
    Header set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"

    # Enable XSS protection
    Header set X-XSS-Protection "1; mode=block"

    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Content Security Policy (adjust as needed)
    # Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://api.web3forms.com; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self' data:;"
</IfModule>

# =====================================================
# MIME TYPES
# =====================================================

<IfModule mod_mime.c>
    # WebP images
    AddType image/webp .webp

    # JavaScript
    AddType application/javascript .js
    AddType application/json .json

    # CSS
    AddType text/css .css

    # Fonts
    AddType font/woff .woff
    AddType font/woff2 .woff2
</IfModule>

# =====================================================
# ERROR PAGES (Optional)
# =====================================================

# ErrorDocument 404 /standalone-tools/piercing-angle-guide/404.html
# ErrorDocument 500 /standalone-tools/piercing-angle-guide/500.html

# =====================================================
# DENY ACCESS TO SENSITIVE FILES
# =====================================================

<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "(README|CHANGELOG|LICENSE|\.md|\.txt|\.log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# =====================================================
# ALLOW EMBEDDING IN IFRAMES
# =====================================================

# For embed.html specifically, allow cross-origin embedding
<Files "embed.html">
    Header set X-Frame-Options "ALLOWALL"
    Header set Access-Control-Allow-Origin "*"
</Files>

# =====================================================
# PREVENT HOTLINKING (Optional)
# =====================================================

# Prevent other sites from using your images/resources
# <IfModule mod_rewrite.c>
#     RewriteCond %{HTTP_REFERER} !^$
#     RewriteCond %{HTTP_REFERER} !^https://(www\.)?poliinternational\.com [NC]
#     RewriteRule \.(webp|jpg|jpeg|png|gif|svg)$ - [F,L]
# </IfModule>

# =====================================================
# END OF CONFIGURATION
# =====================================================
